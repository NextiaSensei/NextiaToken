{
  "name": "nextia-token",
  "version": "1.0.0",
  "description": "Proyecto Hardhat para el token Nextia (NXT)",
  "main": "index.js",
  "scripts": {
    "test": "npx hardhat test",
    "test:unit": "HARDHAT_NETWORK=hardhat npx hardhat test",
    "test:local": "HARDHAT_NETWORK=localhost npx hardhat test",
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.js --network localhost",
    "coverage": "npx hardhat coverage",
    "gas": "REPORT_GAS=true npx hardhat test test/NextiaToken.gas.test.js",
    "gas:all": "REPORT_GAS=true npx hardhat test",
    "ci": "npx hardhat test && REPORT_GAS=true npx hardhat test && npx hardhat coverage",
    "admin:status": "ACTION=status node scripts/admin.js",
    "admin:mint": "ACTION=mint node scripts/admin.js",
    "admin:pause": "ACTION=pause node scripts/admin.js",
    "admin:unpause": "ACTION=unpause node scripts/admin.js",
    "report:html": "npx hardhat test -- --reporter mochawesome --reporter-options reportDir=reports,reportFilename=index,quiet=true,overwrite=true,html=true,json=true"
  },
  "author": "George & BroDev",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.26.3",
    "hardhat-gas-reporter": "^1.0.10",
    "husky": "^9.1.7",
    "mocha": "^11.7.4",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.6.2",
    "solhint": "^6.0.1",
    "solidity-coverage": "^0.8.16"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "ethers": "^6.15.0"
  },
  "directories": {
    "doc": "docs",
    "example": "example",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NextiaSensei/NextiaToken.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/NextiaSensei/NextiaToken/issues"
  },
  "homepage": "https://github.com/NextiaSensei/NextiaToken#readme"
}
